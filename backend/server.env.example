APP_NAME=AgroVision AI
ENVIRONMENT=production

# Keep this restricted to deployed frontend URLs in production.
# Add local frontend only if you need to test from your laptop.
FRONTEND_ORIGINS=https://agro-vision-ai-ochre.vercel.app
ALLOW_ALL_ORIGINS=false

# Existing trained model paths. Do not change unless the model files are stored elsewhere on the server.
MODEL_PATH=../models/EfficientNetB0.h5
CLASS_NAMES_PATH=../models/class_names.json
MODEL_FAMILY=efficientnet

MEDICINAL_MODEL_PATH=../models/medicinal_disease_recognition_model.h5
MEDICINAL_CLASS_NAMES_PATH=../models/medicinal_disease_recognition_model_classes.json
MEDICINAL_MODEL_FAMILY=raw

IMAGE_SIZE=224
MAX_UPLOAD_MB=8

# AI provider selection
# AI_PROVIDER=auto uses AI_PROVIDER_ORDER.
# Set AI_PROVIDER to one of: auto, gemini, groq, deepseek, ollama, static
AI_PROVIDER=auto
AI_PROVIDER_ORDER=gemini,groq,deepseek,ollama,static

# Optional. Leave blank if we are using only local Qwen/Ollama guidance.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional. If configured, Groq is used after Gemini in the default order.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=45

# Optional. If configured, NVIDIA DeepSeek is used after Gemini and before Ollama/Qwen.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=deepseek-ai/deepseek-v4-flash
NVIDIA_TIMEOUT_SECONDS=90
NVIDIA_THINKING=false

# Local LLM on the same server. Keep disabled only if Ollama is not installed.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_SECONDS=90

# Optional integrations.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Must be changed on the server.
ADMIN_TOKEN=replace-with-a-long-random-secret
